# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

# PostgreSQL
DATABASE_URL=postgres://hashhive:hashhive@127.0.0.1:5432/hashhive

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Object storage (SeaweedFS in dev via docker-compose, AWS S3 in hosted envs).
# The S3 API is the contract -- env var names stay provider-neutral.
# `minioadmin` is kept as the dev default for back-compat with existing
# .env files; the SeaweedFS IAM config at docker/seaweedfs/s3-iam.json
# accepts the same credentials.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hashhive
S3_REGION=us-east-1

# BetterAuth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-betterauth-secret-change-in-production-min32chars

# Directory (LDAP / Active Directory) sign-in. Off by default; local
# email/password login is unaffected until you set LDAP_ENABLED=true.
# See docs/development.md for the full reference and memberOf vs search guidance.
LDAP_ENABLED=false
# LDAP_URL=ldaps://dc.lab.local:636
# LDAP_TLS=ldaps                       # ldaps | starttls | none
# LDAP_ALLOW_INSECURE_TRANSPORT=false  # must be true to allow LDAP_TLS=none (plaintext)
# LDAP_TLS_CA_CERT=/etc/hashhive/ldap-ca.pem
# LDAP_BIND_DN=cn=svc-hashhive,ou=service,dc=lab,dc=local
# LDAP_BIND_PASSWORD=change-me
# LDAP_SEARCH_BASE=ou=people,dc=lab,dc=local
# LDAP_USER_FILTER=(sAMAccountName=%s)
# LDAP_GROUP_STRATEGY=memberOf         # memberOf (AD) | search (OpenLDAP)
# LDAP_GROUP_BASE=ou=groups,dc=lab,dc=local   # required when LDAP_GROUP_STRATEGY=search
# LDAP_GROUP_ADMIN=hh-admins
# LDAP_GROUP_OPERATOR=hh-operators
# LDAP_GROUP_ANALYST=hh-analysts
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_REALM=lab.local

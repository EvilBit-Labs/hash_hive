{
  "name": "hashhive",
  "version": "1.0.0",
  "private": true,
  "description": "HashHive - Distributed password cracking platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "oxlint-tsgolint": "0.23.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "ioredis": "5.11.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.4"
}
